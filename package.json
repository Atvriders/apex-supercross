{
  "name": "apex-supercross",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "APEX SUPERCROSS - Stadium Series. Original Xbox 360-style MX/ATV supercross game. All 3D assets built procedurally in Blender. Generated & built by DeepSeek V4 Pro.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 8080",
    "serve": "vite preview --host 0.0.0.0 --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "smoke": "playwright test smoke",
    "assets": "bash blender/rebuild_all.sh"
  },
  "dependencies": {
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/three": "0.185.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.57.0"
  }
}
